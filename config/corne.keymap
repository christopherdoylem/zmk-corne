#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define FUNCTION 3
#define NAV 4
#define ___ &trans

/ {
	combos {
		compatible = "zmk,combos";
			combo_enter {
				timeout-ms = <50>;
				key-positions = <19 20 21>;
				bindings = <&kp RETURN>;
			};
			combo_ctrl-backspace {
				timeout-ms = <50>;
				key-positions = <31 32 33>;
				bindings = <&kp LC(BSPC)>;
			};
	        combo_left-parenthesis {
				timeout-ms = <50>;
				key-positions = <7 8>;
				bindings = <&kp LPAR>;
			};
	        combo_right-parenthesis {
				timeout-ms = <50>;
				key-positions = <8 9>;
				bindings = <&kp RPAR>;
			};
	        combo_left-bracket {
				timeout-ms = <50>;
				key-positions = <31 32>;
				bindings = <&kp LBKT>;
			};
	        combo_right-bracket {
				timeout-ms = <50>;
				key-positions = <32 33>;
				bindings = <&kp RBKT>;
			};
	};
	
    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        th: taphold {
            compatible = "zmk,behavior-hold-tap";
			label = "TAP HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
        };

		num_word: num_word {
			compatible = "zmk,behavior-auto-layer";
      		#binding-cells = <0>;
	        layers = <LOWER>; // Replace NUM by index of numbers layer
	        continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
	        ignore-numbers;
		};
    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                            &kp TAB       &kp B         &kp L         &kp D         &kp W         &kp Z           &th DQT SQT   &kp F          &kp O         &kp U         &kp J         &kp SEMI   
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                            &kp LCTRL     &lt RAISE N   &HML LCTRL R  &HML LALT T   &lt NAV S     &kp G           &kp Y        &lt LOWER H     &HMR LALT A   &HMR LCTRL E  &lt RAISE I   &kp COMMA  
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                            &mo FUNCTION  &kp Q         &kp X         &kp M         &kp C         &kp V           &kp K        &th LS(SLASH) P &kp DOT       &kp MINUS     &kp SLASH     &kp ESCAPE 
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                      &num_word     &kp BSPC      &kp LSHFT       &kp RETURN   &th RGUI SPACE &mo RAISE
                        //                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };  

                lower_layer {
                        display-name = "Lower";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___         ___            ___           ___           ___           ___           ___            &kp N7        &kp N8        &kp N9       &kp N0        ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                            &bootloader     &kp TAB       &kp DEL        ___           ___           ___             ___          &kp N4        &kp N5        &kp N6        ___         &bootloader 
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___           ___          ___           ___           ___           ___             ___          &kp N1        &kp N2        &kp N3        ___           ___       
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___             ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                raise_layer {
                        display-name = "Raise";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___         &kp EXCL      &kp AT       &kp HASH      &kp DLLR      &kp PRCNT       &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR        ___      
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         &kp ESCAPE    ___          &kp MINUS     &kp EQUAL       ___              ___        &kp LBKT      &kp RBKT      &kp BSLH      &kp GRAVE       ___      
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         ___           ___          &kp UNDER     &kp PLUS        ___              ___        &kp LBRC      &kp RBRC      &kp PIPE      &kp TILDE       ___      
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___              ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯


                        >;
                };

                function_layer {
                        display-name = "Function";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___         &kp F12       &kp F7        &kp F8        &kp F9        ___              ___          ___          ___             ___           ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         &kp F11       &kp F4        &kp F5        &kp F6        ___            &kp C_MUTE   &kp C_VOL_UP   &kp PG_UP       ___           ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         &kp F10       &kp F1        &kp F2        &kp F3        ___              ___        &kp C_VOL_DN   &kp PG_DN       ___           ___           ___        
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___             ___           ___            ___
                                                        //          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯

                         >;
                };

                nav_layer {
                        display-name = "Nav";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___          ___           ___           ___           ___           ___             ___          ___           &kp UP        ___            ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___          ___           ___           ___           ___           ___             ___          &kp LEFT      &kp DOWN     &kp RIGHT       ___           ___ 
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___          ___           ___           ___           ___           ___             ___           ___           ___          ___            ___           ___       
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___             ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                  extra_2 { status = "reserved"; };
      };
};
