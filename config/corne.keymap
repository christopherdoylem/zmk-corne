#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define GAMING 3
#define NAV 4
#define ___ &trans
#define slashP &th LS(SLASH) P
#define HYPEReturn &tb LS(LC(LA(LGUI))) RETURN
#define MehSpace &tb LS(LC(LALT)) SPACE

/ {
        combos {
                compatible = "zmk,combos";
                        combo_enter {
                                timeout-ms = <50>;
                                key-positions = <19 20 21>;
                                bindings = <&kp RETURN>;
                        };
                        combo_ctrl-backspace {
                                timeout-ms = <50>;
                                key-positions = <31 32 33>;
                                bindings = <&kp LC(BSPC)>;
                        };
                        combo_left-parenthesis {
                                timeout-ms = <50>;
                                key-positions = <7 8>;
                                bindings = <&kp LPAR>;
                        };
                        combo_right-parenthesis {
                                timeout-ms = <50>;
                                key-positions = <8 9>;
                                bindings = <&kp RPAR>;
                        };
                        combo_left-bracket {
                                timeout-ms = <50>;
                                key-positions = <19 20>;
                                bindings = <&kp LBKT>;
                        };
                        combo_right-bracket {
                                timeout-ms = <50>;
                                key-positions = <20 21>;
                                bindings = <&kp RBKT>;
                        };
                        combo_left-squiggle {
                                timeout-ms = <50>;
                                key-positions = <31 32>;
                                bindings = <&kp LBRC>;
                        };
                        combo_right-squiggle {
                                timeout-ms = <50>;
                                key-positions = <32 33>;
                                bindings = <&kp RBRC>;
                        };
                        combo_colon {
                                timeout-ms = <40>;
                                bindings = <&kp SEMI>;
                                key-positions = <18 19>;
                        };
                        combo_angle {
                                timeout-ms = <40>;
                                bindings = <&angle_morph>;
                                key-positions = <16 18>;
                        };
        };

    behaviors {
        HML: HML {
                compatible = "zmk,behavior-hold-tap";
                label = "HML";
                bindings = <&kp>, <&kp>;

                #binding-cells = <2>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                require-prior-idle-ms = <150>;
                flavor = "balanced";
                hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
                hold-trigger-on-release;
        };

        HMR: HMR {
                compatible = "zmk,behavior-hold-tap";
                label = "HMR";
                bindings = <&kp>, <&kp>;

                #binding-cells = <2>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                require-prior-idle-ms = <150>;
                flavor = "balanced";
                hold-trigger-on-release;
                hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        th: taphold {
                compatible = "zmk,behavior-hold-tap";
                label = "TAP HOLD FOR FINGER KEYS";
                bindings = <&kp>, <&kp>;

                #binding-cells = <2>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                require-prior-idle-ms = <150>;
                flavor = "tap-preferred";
        };

        tb: thumbtaphold {
                compatible = "zmk,behavior-hold-tap";
                label = "TAP HOLD FOR THUMBS";
                bindings = <&kp>, <&kp>;

                #binding-cells = <2>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                // require-prior-idle-ms = <150>;
                flavor = "tap-preferred";
        };

        num_word: num_word {
                compatible = "zmk,behavior-auto-layer";
                #binding-cells = <1>;
                continue-list = <N1 N2 N3 N4 N5 N6 N7 N8 N9 N0 BSPC DEL DOT COMMA SPACE SEMI>;
                ignore-numbers;
        };

        f_word: num_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12 MINUS EQUAL UNDER PLUS>;
        };

        td_B: tap_dance_bold_b {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp B>, <&kp LC(B)>;
        };
        
        angle_morph: angle_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "angle_morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___       &kp B         &kp L         &kp D         &HML LGUI W    &kp Z           &th DQT SQT  &HMR LGUI F    &kp O         &kp U         &kp J         ___   
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___       &lt 2 N       &HML LCTRL R  &HML LALT T   &lt 4 S        &kp G           &kp Y        &lt 4 H        &HMR LALT A   &HMR LCTRL E  &lt 2 I       &kp COMMA  
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                            &tog 3        &kp Q         &kp X         &kp M         &kp C          &kp V           &kp K        slashP         &kp DOT       &kp MINUS     &kp SLASH     &kp COMMA 
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                      &num_word 1   &kp BSPC       &kp LSHFT       HYPEReturn   MehSpace       &f_word 2
                        //                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };  
       
                lower_layer {   
                        display-name = "Lower";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___           ___         &kp AMPS      &kp ASTRK      ___           ___             ___          &kp N7        &kp N8        &kp N9       &kp N0         ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___        &kp ESCAPE     &kp DLLR      &kp PRCNT     &kp CARET      ___             ___          &kp N4        &kp N5        &kp N6        ___           ___ 
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___           ___         &kp EXCL      &kp AT        &kp HASH       ___             ___          &kp N1        &kp N2        &kp N3        ___           ___       
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___             ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                raise_layer {
                        display-name = "Raise";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___         ___           ___           ___          ___             ___            &kp F12       &kp F7        &kp F8        &kp F9     &kp TILDE         ___
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         &kp ESCAPE    ___          &kp MINUS     &kp EQUAL       ___            &kp F11       &kp F4        &kp F5        &kp F6     &kp BSLH        &kp GRAVE        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___         ___           ___          &kp UNDER     &kp PLUS        ___            &kp F10       &kp F1        &kp F2        &kp F3     &kp PIPE        &kp GRAVE
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___              ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯


                        >;
                };

                gaming_layer {
                        display-name = "Gaming";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                            &kp ESCAPE      &kp T          &kp Q         &kp W         &kp E        &kp R            ___           ___            ___          ___           ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                               &kp TAB      &kp G          &kp A         &kp S         &kp D        &kp F            ___           ___            ___          ___           ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                               &kp I        &kp V          &kp Z         &kp X         &kp C        &kp V            ___           ___            ___          ___           ___         &tog 3        
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                       &kp LCTRL    &kp RETURN      &kp LSHFT        ___           ___            ___
                                                        //          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯

                         >;
                };

                nav_layer {
                        display-name = "Nav";
                        bindings = <
                        //╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                                ___          ___        &kp LC (TAB)   &kp DELETE    &kp C_MUTE      ___             ___        &kp LC(C)       ___         &kp LC(V)         ___           ___        
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___       &kp ESCAPE      &kp TAB        ___         &kp C_VOL_UP    ___          &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT     &kp LC(PLUS)      ___ 
                        //├─────────────┬─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────┤
                                ___          ___           ___           ___         &kp C_VOL_DN    ___             ___        &kp PG_UP      &kp CAPS     &kp PG_DN     &kp LC(MINUS)     ___        
                        //╰─────────────┬─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                                         ___           ___           ___             ___           ___           ___
                                                       //           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
                        >;
                };

                  extra_2 { status = "reserved"; };
      };
};          
