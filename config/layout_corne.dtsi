// corne -- generated from its matrix_transform. 42 keys.
// LAYOUT() takes the canonical 46 slots and keeps the 42 this board has.

#define LAYOUT( \
    l1, l2, l3, l4, l5, \
    r1, r2, r3, r4, r5, \
    l6, l7, l8, l9, l10, \
    r6, r7, r8, r9, r10, \
    l11, l12, l13, l14, l15, \
    r11, r12, r13, r14, r15, \
    lt1, lt2, lt3, rt1, rt2, \
    rt3, o1l, o1r, o2l, o2r, \
    o3l, o3r, midl, midr, t4l, \
    t4r)  \
     o1l   l1   l2   l3   l4   l5   r1   r2   r3   r4   r5  o1r \
     o2l   l6   l7   l8   l9  l10   r6   r7   r8   r9  r10  o2r \
     o3l  l11  l12  l13  l14  l15  r11  r12  r13  r14  r15  o3r \
     lt1  lt2  lt3  rt1  rt2  rt3

// hands, for hold-trigger-key-positions (cols 0-5 = left, 6+ = right)
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 \
               16 17 24 25 26 27 28 29 36 37 \
               38
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 \
               22 23 30 31 32 33 34 35 39 40 \
               41

